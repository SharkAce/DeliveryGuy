  dropOffPoint: {fileID: 9120762582620814946}
  bossLine: 
  dialogueLines:
  - "How\u2019d your first delivery go?\r\nDon\u2019t answer. I\u2019m busy\r."
  - "Mark told me you did well,\r\nbut he told me he saw you drift on that damn corner,
    kid.\r"
  - "My son will add a delivery quality tracker to your screen,\r\nso you\u2019re
    more careful next time.\r\n"
  - "Don\u2019t worry. He\u2019s just a kid"
  - ...
  - "Anyway, you\u2019ve got the next delivery,\r\nand I\u2019ve got to go. Be careful,
    kid.\r"
