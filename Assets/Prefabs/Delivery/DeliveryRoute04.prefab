MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8969046492165771024}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a512633cbd048b748abcf492b6222e19, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  pickupName: Lung Fung
  destinationName: Jonnas
  orderName: Chicken Noodle Soup (No Bones)
  pickupPoint: {fileID: 8969046491196473357}
  dropOffPoint: {fileID: 8969046492351422587}
  bossLine: 
  dialogueLines:
  - "Next one\u2019s from Lung Fung.\r\nThey sell decent soup, you know\r."
  - "My wife doesn\u2019t let me eat there,\r\nshe says the waitress has got an eye
    on me\r."
  - "Anyway, Guy, be careful with the next one.\r\nIt\u2019s\u2026ehm\u2026the soup
    can spill easily.\r\n"
  - "Deliver it to Jonnas. Skinny, tall guy.\r\nYou\u2019ll know once you see him\r."
  arrivalLines:
  - "Just\u2013just leave it here. Actually\u2026wait.\r\nCome closer. Quick. Come.\r"
  - Did anyone follow you here?
  - "Never\u2026mind. Gimme the mea\u2013soup.\r\nThe soup. Forget what I said. Here.\r"
  arrivalSpeakerName: JONAS
  hasEnergyDrinkPrompt: 0
  skipDialogueLines: []
  timedDelivery: 1
  targetDeliveryTime: 80
  baseTip: 12
  baseScore: 1000
