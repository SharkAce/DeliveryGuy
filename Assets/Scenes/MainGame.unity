      propertyPath: targetDeliveryTime
      value: 80
      objectReference: {fileID: 0}
    - target: {fileID: 1974612771896197913, guid: cab1c47827213df4d842368a849add8d,
        type: 3}
      propertyPath: dialogueLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 1974612771896197913, guid: cab1c47827213df4d842368a849add8d,
        type: 3}
      propertyPath: dialogueLines.Array.data[1]
      value: 'Mark told me you did well,

        but he told me you delivered it
        late, kid.'
      objectReference: {fileID: 0}
    - target: {fileID: 1974612771896197913, guid: cab1c47827213df4d842368a849add8d,
        type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "My son will add a timer to your screen,\r\nso you\u2019re faster next
        time.\r\n"
      objectReference: {fileID: 0}
    - target: {fileID: 1974612771896197913, guid: cab1c47827213df4d842368a849add8d,
        type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "Anyway, you\u2019ve got the next delivery,\r\nand I\u2019ve got to
        go. Be careful, kid.\r"
      objectReference: {fileID: 0}
    - target: {fileID: 1974612771896197913, guid: cab1c47827213df4d842368a849add8d,
        type: 3}
