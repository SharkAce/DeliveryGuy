    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: targetDeliveryTime
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: arrivalLines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: dialogueLines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: arrivalLines.Array.data[2]
      value: Looks good, but be a bit faster next time.
      objectReference: {fileID: 0}
    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: arrivalLines.Array.data[3]
      value: I'm feeling generous today. Let me send you off with a big tip.
      objectReference: {fileID: 0}
    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: dialogueLines.Array.data[2]
      value: "Your first delivery\u2019s waiting at Kinney\u2019s Pizza. Use WASD
        or the arrow keys to drive and SPACE for the handbrake."
      objectReference: {fileID: 0}
    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: dialogueLines.Array.data[3]
      value: "Follow the arrow, then press E when you\u2019re close enough to collect
        the order. After that, take it to Mark.\n\n"
      objectReference: {fileID: 0}
    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: dialogueLines.Array.data[4]
      value: "Oh, and one more thing. Drive carefully!\nThe pizza is\u2026 thin.
        That\u2019s how Mark likes it\r."
      objectReference: {fileID: 0}
    - target: {fileID: 8623931896904174920, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: m_Name
      value: DeliveryRoute01
      objectReference: {fileID: 0}
