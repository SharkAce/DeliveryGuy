--- !u!1001 &8623931895785777044
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 603404868}
    m_Modifications:
    - target: {fileID: 5231561688783948522, guid: e89826cc45d6efa4b8d5d10b024fa26e,
        type: 3}
      propertyPath: timedDelivery
      value: 0
