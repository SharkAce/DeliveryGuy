--- !u!1001 &6539278443743841922
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    m_TransformParent: {fileID: 603404868}
    m_Modifications:
    - target: {fileID: 1974612771896197913, guid: cab1c47827213df4d842368a849add8d,
